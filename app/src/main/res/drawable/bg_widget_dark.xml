<?xml version="1.0" encoding="utf-8"?>
<!-- v9.88.4 深色毛玻璃：墨蓝低饱和底 + 顶部高光带 + 底部暗角 + 描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃底：墨蓝渐变 -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#B31B2537"
                android:endColor="#8C151E2E"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 底部暗角：玻璃下缘厚度感 -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#1A000000"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 顶部高光带：玻璃边缘反光 -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#33FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 玻璃描边 -->
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
