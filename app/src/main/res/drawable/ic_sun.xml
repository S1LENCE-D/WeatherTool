    <!-- 对角光芒（旋转 45° 复用） -->
    <group android:rotation="45" android:pivotX="12" android:pivotY="12">
        <path android:pathData="M12,5.5 L12,1.5" android:strokeColor="#1A1A1A" android:strokeWidth="1.0" android:strokeLineCap="round" />
        <path android:pathData="M12,18.5 L12,22.5" android:strokeColor="#1A1A1A" android:strokeWidth="1.0" android:strokeLineCap="round" />
