<?xml version="1.0" encoding="utf-8"?>
<!-- v9.88.4 浅色毛玻璃：低饱和灰调底（不再刺眼）+ 顶部高光带 + 底部暗角 + 描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 玻璃底：低饱和灰蓝渐变（顶部亮、底部暗，模拟玻璃厚度） -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#B3E9EDF4"
                android:endColor="#8CDDE4EC"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 底部暗角：玻璃下缘厚度感 -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#14000000"
                android:endColor="#00000000"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 顶部高光带：玻璃边缘反光 -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- 玻璃描边 -->
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
