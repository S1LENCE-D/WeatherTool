<?xml version="1.0" encoding="utf-8"?>
<!-- 外观设置弹窗（深色主题）：主题三选一 Bottom Sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_light"
    android:paddingLeft="22dp"
    android:paddingRight="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="30dp">

    <!-- 拖拽把手指示条 -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle_light" />

    <!-- 标题区 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设置"
        android:textColor="#1F2A36"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="选择界面主题，切换立即生效"
        android:textColor="#8A5C6B7A"
        android:textSize="12sp" />

    <!-- 跟随系统 -->
    <LinearLayout
        android:id="@+id/optSystem"
        android:tag="system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row_light"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/themeRadioSystem"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_radio_selector_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随系统"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="随系统设置自动切换深色或浅色"
                android:textColor="#595C6B7A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 深色 -->
    <LinearLayout
        android:id="@+id/optDark"
        android:tag="dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row_light"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/themeRadioDark"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_radio_selector_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="深色"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="深色天空渐变 · 夜间更护眼"
                android:textColor="#595C6B7A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 浅色 -->
    <LinearLayout
        android:id="@+id/optLight"
        android:tag="light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row_light"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/themeRadioLight"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_radio_selector_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="浅色"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="明亮天空渐变 · 白天更清爽"
                android:textColor="#595C6B7A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>


    <!-- v9.46：定位方式 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="定位方式"
        android:textColor="#1F2A36"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="刷新时按所选方式重新定位"
        android:textColor="#595C6B7A"
        android:textSize="12sp" />

    <!-- 自动 -->
    <LinearLayout
        android:id="@+id/optLocAuto"
        android:tag="auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row_light"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/locRadioAuto"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_radio_selector_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动切换"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="GPS 可用时优先，否则 IP 定位"
                android:textColor="#595C6B7A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- GPS -->
    <LinearLayout
        android:id="@+id/optLocGps"
        android:tag="gps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row_light"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/locRadioGps"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_radio_selector_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS 定位"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="卫星/网络定位 · 更精准"
                android:textColor="#595C6B7A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- IP -->
    <LinearLayout
        android:id="@+id/optLocIp"
        android:tag="ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row_light"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <View
            android:id="@+id/locRadioIp"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_radio_selector_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP 定位"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="按网络 IP 估算 · 结果可能有偏差"
                android:textColor="#595C6B7A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- v9.70：预警推送 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="预警推送"
        android:textColor="#1F2A36"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="每 30 分钟检查本地气象预警，黄色及以上自动提醒"
        android:textColor="#66717E"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后台预警监控"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="前台服务保活 · 建议允许自启动"
                android:textColor="#8A93A0"
                android:textSize="11sp" />
        </LinearLayout>

        <com.simpleweather.app.M3Switch
            android:id="@+id/alertWatchSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- v9.88：后台常驻（进程保活，划掉任务后推送/刷新照常） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_opt_row"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="后台常驻"
                android:textColor="#1F2A36"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="划掉后台任务后仍保持推送与自动刷新"
                android:textColor="#8A93A0"
                android:textSize="11sp" />
        </LinearLayout>

        <com.simpleweather.app.M3Switch
            android:id="@+id/keepAliveSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- v9.88：自启动设置引导（国产 ROM 强制停止后需到系统设置放行） -->
    <TextView
        android:id="@+id/keepAliveHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:text="若系统仍拦截后台，请点击此处前往系统设置，允许自启动与忽略电池优化"
        android:textColor="#8A93A0"
        android:textSize="12sp" />

    <!-- 完成 -->
    <TextView
        android:id="@+id/themeDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="完成"
        android:textColor="#2F6FEB"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
